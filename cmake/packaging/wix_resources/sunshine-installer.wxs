<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
        <Component Id="ApplicationShortcutRoot" Guid="*">
            <Shortcut Id="ApplicationStartMenuShortcutRoot"
                      Name="novaling"
                      Description="novaling Remote Streaming Host"
                      Target="[INSTALL_ROOT]novaling.exe"
                      Arguments="--shortcut"
                      WorkingDirectory="INSTALL_ROOT"/>
            <RegistryValue Root="HKCU" Key="Software\novaling" Name="installed_root" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
        <Directory Id="ProgramMenuSubfolder" Name="novaling">
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="novaling"
                          Description="novaling Remote Streaming Host"
                          Target="[INSTALL_ROOT]novaling.exe"
                          Arguments="--shortcut"
                          WorkingDirectory="INSTALL_ROOT"/>
                <RemoveFolder Id="CleanUpShortCutParent" Directory="ProgramMenuSubfolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\novaling" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </Directory>
    </StandardDirectory>

    <!-- Install: Run novaling-setup.ps1 with -Action install, add -Silent if UILevel <= 3 -->
    <CustomAction Id="CA_NovalingInstall" Directory="INSTALL_ROOT" ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\novaling-setup.ps1&quot; -Action install" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="CA_NovalingInstallSilent" Directory="INSTALL_ROOT" ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\novaling-setup.ps1&quot; -Action install -Silent" Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Uninstall: Run novaling-setup.ps1 with -Action uninstall, add -Silent if UILevel <= 3 -->
    <CustomAction Id="CA_NovalingUninstall" Directory="INSTALL_ROOT" ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\novaling-setup.ps1&quot; -Action uninstall" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="CA_NovalingUninstallSilent" Directory="INSTALL_ROOT" ExeCommand="powershell.exe -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\novaling-setup.ps1&quot; -Action uninstall -Silent" Execute="deferred" Return="ignore" Impersonate="no" />

    <InstallExecuteSequence>
        <Custom Action="CA_NovalingInstall" After="InstallFiles" Condition="NOT Installed AND UILevel &gt; 3" />
        <Custom Action="CA_NovalingInstallSilent" After="InstallFiles" Condition="NOT Installed AND UILevel &lt;= 3" />

        <Custom Action="CA_NovalingUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND UILevel &gt; 3" />
        <Custom Action="CA_NovalingUninstallSilent" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND UILevel &lt;= 3" />
    </InstallExecuteSequence>

    <Feature Id="RunNovalingInstallScripts" Title="Run novaling Installation Scripts" Level="1" Display="hidden">
       <ComponentRef Id="ApplicationShortcutRoot" />
       <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Fragment>
</Wix>
