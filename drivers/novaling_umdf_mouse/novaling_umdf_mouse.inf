;
; novaling_umdf_mouse.inf
; UMDF 2.15 + Virtual HID Framework (VHF) Virtual Mouse Driver
;

[Version]
Signature   = "$Windows NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ProviderName%
CatalogFile = novaling_umdf_mouse.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
novaling_umdf_mouse.dll = 1

[Manufacturer]
%MfgName% = Standard,NTamd64.10.0...17134

[Standard.NTamd64.10.0...17134]
%DeviceDesc% = NovalingUmdfMouse_Install, Root\NovalingUmdfMouse

[NovalingUmdfMouse_Install.NT]
CopyFiles = NovalingUmdfMouse_CopyFiles

[NovalingUmdfMouse_CopyFiles]
novaling_umdf_mouse.dll

[NovalingUmdfMouse_Install.NT.HW]
AddReg = NovalingUmdfMouse_HW_AddReg

[NovalingUmdfMouse_HW_AddReg]
HKR,,"LowerFilters",0x00010008,"vhf"
HKR,,"VhfMode",0x00010001,0x2
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;LS)(A;;GA;;;BA)(A;;GA;;;UD)"

[NovalingUmdfMouse_Install.NT.Services]
AddService = WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[NovalingUmdfMouse_Install.NT.Wdf]
UmdfService                = NovalingUmdfMouse,NovalingUmdfMouse_WdfInstall
UmdfServiceOrder           = NovalingUmdfMouse
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfMethodNeitherAction    = Copy
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects

[NovalingUmdfMouse_WdfInstall]
UmdfLibraryVersion = 2.15.0
ServiceBinary      = %13%\novaling_umdf_mouse.dll

[Strings]
ProviderName      = "novaling"
MfgName           = "novaling"
DiskName          = "novaling Virtual Mouse UMDF Driver Disk"
DeviceDesc        = "novaling Virtual HID Mouse (UMDF)"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
